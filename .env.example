VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_KEY=replace_me
ROUTER_MODEL=google/gemini-3.1-flash-lite
# Modèle de réponse de l'application (prod). Le notebook atelier choisit le modèle en section 7 (WORKSHOP_ANSWER_MODEL_KEY).
ANSWER_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=alibaba/qwen3-embedding-4b
CHROMA_PATH=./data/chroma_db
SQLITE_PATH=./data/knowledge.db
SOURCE_DOCUMENTS_PATH=./data/source_documents
CHUNK_SIZE=500
CHUNK_OVERLAP=50
VECTOR_TOP_K=10
GATEWAY_MAX_RETRIES=5
GATEWAY_MAX_RETRY_DELAY_SECONDS=60
EMBEDDING_BATCH_SIZE=8
EMBEDDING_BATCH_DELAY_SECONDS=2
MAX_UPLOAD_SIZE_MB=20
OCR_DPI=200
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
